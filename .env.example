SHAR_PROVIDER=mock
# Required for Gemini; no model is silently selected.
# SHAR_MODEL=your-accessible-model
# GEMINI_API_KEY=
SHAR_STORAGE_ROOT=runtime
SHAR_HOST=127.0.0.1
# For remote deployment, use token mode and a JSON token-to-owner mapping.
# SHAR_AUTH_MODE=token
# SHAR_AUTH_TOKENS={"replace-with-long-random-secret":"owner-1"}

# Total calls per run, including all stages and retries. One call disables recovery.
# SHAR_MAX_CALLS=12
# SHAR_PROVIDER_MAX_ATTEMPTS=3
# SHAR_RETRY_BASE_SEC=2
# SHAR_RETRY_MAX_SEC=30

# Interactive runs always require approval before retrying a failed request.
SHAR_REQUIRE_RETRY_APPROVAL=true
